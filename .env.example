# ==============================================================================
# Text2SQL2Chart — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Load before running:
#   set -a && source .env && set +a
#
# All values below are placeholders. Never commit your real .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Provider (required — choose one)
# ------------------------------------------------------------------------------
AI_PROVIDER=openai                      # openai or gemini

# OpenAI (default provider)
OPENAI_API_KEY=your-openai-api-key      # Required if AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini                # Model to use

# Gemini (alternative provider)
GEMINI_API_KEY=your-gemini-api-key      # Required if AI_PROVIDER=gemini

# Model used by examples/retrain_vanna_alibaba.py
VANNA_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# TimescaleDB (historical pipeline)
# ------------------------------------------------------------------------------
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_DB=hpc_monitoring
TIMESCALEDB_USER=your-db-user
TIMESCALEDB_PASSWORD=your-db-password

# ------------------------------------------------------------------------------
# InfluxDB 2.x (realtime pipeline)
# ------------------------------------------------------------------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token      # InfluxDB UI: Load Data > API Tokens
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=metrics

# ------------------------------------------------------------------------------
# Grafana (realtime panels are pushed here; needs an InfluxDB datasource)
# ------------------------------------------------------------------------------
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=your-grafana-user
GRAFANA_PASSWORD=your-grafana-password

# ------------------------------------------------------------------------------
# API Server
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=5000
API_URL_INTERNAL=http://api-server:5000 # URL Grafana uses inside the Docker network
API_URL_EXTERNAL=http://localhost:5000  # URL used from the host

# ------------------------------------------------------------------------------
# Paths (legacy JSON-datasource dashboards and SQLite demos)
# ------------------------------------------------------------------------------
DATA_DIR=generate_output/grafana/data
DASHBOARD_FILE=generate_output/grafana/grafana_dashboard.json
OUTPUT_DIR=generate_output
DATABASE_PATH=data/sql-murder-mystery.db

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
